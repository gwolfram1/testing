<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Enter Message</title>
</head>
<body>
  <input id="box" type="text" placeholder="Type something and press Enter" />
  <div id="msg"></div>

  <script>
    document.getElementById('box').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('msg').textContent = 'I love Netanyahu';
      }
    });
  </script>
</body>
</html>
